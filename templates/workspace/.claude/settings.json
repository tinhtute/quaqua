{
  "permissions": {
    "deny": ["Agent"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/herdr-gate.sh --session-start" },
          { "type": "command", "command": "d=${CLAUDE_PROJECT_DIR:-.}; [ -x \"$d/scripts/hooks/memory-compact.sh\" ] || exit 0; exec \"$d/scripts/hooks/memory-compact.sh\" --session-start" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "d=${CLAUDE_PROJECT_DIR:-.}; [ -x \"$d/scripts/hooks/memory-compact.sh\" ] || exit 0; exec \"$d/scripts/hooks/memory-compact.sh\" --pre-compact" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/herdr-gate.sh" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "q=${QUAQUA_BIN:-$(command -v quaqua || echo \"$HOME/.cargo/bin/quaqua\")}; [ -x \"$q\" ] || exit 0; exec \"$q\" memory hook pre" }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          { "type": "command", "command": "q=${QUAQUA_BIN:-$(command -v quaqua || echo \"$HOME/.cargo/bin/quaqua\")}; [ -x \"$q\" ] || exit 0; exec \"$q\" memory hook batch" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/cos-inbox.sh --user-prompt-submit" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/cos-inbox.sh --stop" }
        ]
      }
    ]
  }
}
