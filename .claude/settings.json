{
  "permissions": {
    "deny": ["Agent"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/crates/qq-core/templates/workspace/scripts/hooks/herdr-gate.sh" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/crates/qq-core/templates/workspace/scripts/hooks/herdr-gate.sh" }
        ]
      }
    ]
  }
}
